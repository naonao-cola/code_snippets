<|ref|>text<|/ref|><|det|>[[72, 721, 280, 739]]<|/det|>
//指定并行度创建本地环境

<|ref|>text<|/ref|><|det|>[[72, 742, 721, 760]]<|/det|>
LocalEnvironment localEnv = ExecutionEnvironment.createLocalEnvironment(10);

<|ref|>text<|/ref|><|det|>[[72, 780, 624, 798]]<|/det|>
